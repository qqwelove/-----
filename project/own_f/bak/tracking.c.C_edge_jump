#include "tracking.h"
#include "image.h"
#include "servo.h"

/* 边线/中线缓存：0 = 最远，119 = 车头 */
uint8 left_line[IMG_H];
uint8 right_line[IMG_H];
uint8 mid_line[IMG_H];
uint8 left_find_flag[IMG_H];
uint8 right_find_flag[IMG_H];

uint8 cross_flag = 0;


/* 每行的半赛道宽：跨帧记忆，自己标定（重平滑，抗噪） */
static int16 half_w_mem[IMG_H];
#define HALF_W_DEF   45      /* 还没学到之前的默认值 */
#define HALF_W_MIN   10
#define HALF_W_MAX   90

/*-------------------------------------------------------------------
 * 逐行提取左右边线并合成中线
 * 赛道模型：白底 + 两侧黑边线；从上一行中线位置出发，向左右找“白→黑”跳变（黑线内沿）
 * ★丢线时保留哨兵值：左丢 left_line=0，右丢 right_line=IMG_W-1
 *------------------------------------------------------------------*/
void scan_lines(uint8 threshold, uint8 *left_line, uint8 *right_line, uint8 *mid_line,
                uint8 start_row, uint8 end_row)
{
    int16 row, col;
    int16 left, right, m;
    uint8 center = IMG_CENTER;
    int16 last_w = HALF_W_DEF;

    for (row = start_row; row >= (int16)end_row; row--)
    {
        left  = -1;
        right = -1;

        /* 左边界：从 center 向左找 白→黑 跳变（黑线右沿 = 白路面左边界） */
        for (col = center; col >= 3; col--)
        {
            if (mt9v03x_image[row][col] > threshold && mt9v03x_image[row][col - 1] <= threshold)
            { left = col; break; }
        }
        /* 右边界：从 center 向右找 白→黑 跳变 */
        for (col = center; col < IMG_W - 3; col++)
        {
            if (mt9v03x_image[row][col] > threshold && mt9v03x_image[row][col + 1] <= threshold)
            { right = col; break; }
        }

        /* 存边线：丢线保留哨兵值 + 置标志位 */
        if (left  < 0) { left_find_flag[row]  = 0; left_line[row]  = 0;           }
        else           { left_find_flag[row]  = 1; left_line[row]  = (uint8)left; }

        if (right < 0) { right_find_flag[row] = 0; right_line[row] = IMG_W - 1;   }
        else           { right_find_flag[row] = 1; right_line[row] = (uint8)right;}

        /* 合成中线：单边丢线用半赛道宽推算，双边丢线继承更近的一行
           ★只写 mid_line，绝对不要回写 left_line / right_line！ */
        if (left_find_flag[row] && right_find_flag[row])
                {
                    int16 w = ((int16)right_line[row] - (int16)left_line[row]) / 2;
                
                    /* ★在线标定“这一行”的半宽 */
                    if (w > HALF_W_MIN && w < HALF_W_MAX)
                    {
                        if (half_w_mem[row] == 0) half_w_mem[row] = w;
                        else half_w_mem[row] = (half_w_mem[row] * 7 + w) / 8;   /* 1/8 步长平滑 */
                        last_w = half_w_mem[row];
                    }
                    m = ((int16)left_line[row] + (int16)right_line[row]) / 2;
                
                    /* 种子只在双边都在时更新（防跑飞，这条要保留） */
                    center = (uint8)m;
                    if (center < SEARCH_RANGE)         center = SEARCH_RANGE;
                    if (center > IMG_W - SEARCH_RANGE) center = IMG_W - SEARCH_RANGE;
                }
        else if (right_find_flag[row])          /* 左丢 → 靠右线 + 该行半宽 */
        {
            int16 hw = (half_w_mem[row] != 0) ? half_w_mem[row] : last_w;
            m = (int16)right_line[row] - hw;
        }
        else if (left_find_flag[row])           /* 右丢 → 靠左线 + 该行半宽 */
        {
            int16 hw = (half_w_mem[row] != 0) ? half_w_mem[row] : last_w;
            m = (int16)left_line[row] + hw;
        }
        else                                    /* 都丢 → 继承更近的一行 */
        {
            m = (row < START_ROW) ? mid_line[row + 1] : IMG_CENTER;
        }
    
        if (m < 0)         m = 0;
        if (m > IMG_W - 1) m = IMG_W - 1;
        mid_line[row] = (uint8)m;

    }
}


/*============================== 行可信度判据（十字检测的基础） ==============================*/
/*-------------------------------------------------------------------
 * 本行“找到的边线”可不可信？
 *   ROW_OK       两侧边线都在，且和“更靠车那一行”接得上
 *   ROW_LOST     只是丢了一侧线，边线本身是连续的（弯道外侧也会这样）
 *   ROW_BOTHLOST 两侧都丢线
 *   ROW_MISMATCH ★找到的边线相对“更靠车那一行”突然跳变
 *                —— 这是十字的专属特征：斜着进十字时，扫描器会突然咬到
 *                   “横向交叉赛道的边线”，位置一跳就是几十像素
 *
 * ★为什么不比“离预测中线多远”：
 *   弯道本身是弯的，越往远处真实中线偏离“直线预测”就越远（急弯能差 100 像素），
 *   用固定阈值永远分不开“弯道”和“十字”。
 *   而相邻行的边线在弯道里一定是连续变化的（每行几个像素），
 *   只有十字/断头这种“边线被截断”的地方才会突跳。
 *------------------------------------------------------------------*/
#define EDGE_JUMP_TOL      15    /* 相邻行同侧边线相差超过这么多像素 → 判定“咬到别的线了” */
#define CROSS_NEAR_OK_MIN  8     /* 车头附近（控制行~车头）至少这么多行可信，才允许补线 */

#define ROW_OK             1
#define ROW_LOST           0
#define ROW_MISMATCH       2
#define ROW_BOTHLOST       3

/* 调试用：十字检测的证据量 */
uint8 dbg_row_mismatch = 0;   /* “边线突跳”的行数 */
uint8 dbg_row_lost     = 0;   /* “只丢一侧”的行数 */
uint8 dbg_row_bothlost = 0;   /* “两侧都丢”的行数 */
uint8 dbg_row_near_ok  = 0;   /* 车头附近可信行数 */

static uint8 row_state(int row)
{
    uint8 lf = left_find_flag[row];
    uint8 rf = right_find_flag[row];
    int   nl = row + 1;                     /* 更靠车的那一行 */
    int   d;

    if (!lf && !rf) return ROW_BOTHLOST;    /* 两侧都丢 */

    /* ★边线连续性：本行边线必须和“更靠车那一行”的同侧边线接得上 */
    if (row < START_ROW)
    {
        if (lf && left_find_flag[nl])
        {
            d = (int)left_line[row] - (int)left_line[nl];
            if (d > EDGE_JUMP_TOL || d < -EDGE_JUMP_TOL) return ROW_MISMATCH;
        }
        if (rf && right_find_flag[nl])
        {
            d = (int)right_line[row] - (int)right_line[nl];
            if (d > EDGE_JUMP_TOL || d < -EDGE_JUMP_TOL) return ROW_MISMATCH;
        }
    }

    if (!lf || !rf) return ROW_LOST;        /* 只丢一侧，且边线连续 → 弯道也会这样 */

    return ROW_OK;
}


/*============================== 十字补线（最小二乘拟合进入方向） ==============================*/
#define CROSS_GAP_MIN     4      /* 异常带至少 4 行才算十字 */
#define CROSS_NEAR_OK     5      /* 近端至少 5 行可信数据才做拟合 */
#define CROSS_FIT_MIN     4      /* 拟合至少需要 4 个有效点 */
#define CROSS_MID_LIMIT   20     /* 中线相对“入口处”最多偏 20 像素（≈6° 舵角） */

/* ★十字判据：不再要求“两侧同时丢线”，改成多证据 */
#define CROSS_MISMATCH_MIN   2   /* “边线突跳”行数 ≥ 2 → 十字（斜着进十字靠这条） */
#define CROSS_BOTHLOST_MIN   6   /* “两侧都丢”行数 ≥ 6 → 十字（正对着进十字靠这条） */

/* 调试用：打到屏幕上就能看出走的是哪条判据、补的是哪一段 */
int16 dbg_cross_a100 = 0;    /* 进入方向斜率 ×100 */
uint8 dbg_cross_m0   = 0;    /* 入口处中线 */
uint8 dbg_cross_m94  = 0;    /* 控制行(94)的中线 */
uint8 dbg_cross_near_lost = 0;   /* 近端断点行号 */
uint8 dbg_cross_far_found = 0;   /* 远端恢复行号（0 = 没找到） */

uint8 cross_fill_new(uint8 *l_line, uint8 *r_line, uint8 *m_line)
{
    int row, near_lost = -1, far_found = -1;
    int ok = 0, n = 0, t, span, mm;
    int L0, R0, L1, R1, l, r, m, m_end;
    int ref_row = -1;                        /* 近端最后一条“可信行” */
    uint8 st, mismatch = 0, lost = 0, bothlost = 0, near_ok = 0;
    float sx = 0, sy = 0, sxx = 0, sxy = 0, den, a = 0.0f, b = 0.0f;

    /* --- 0) 先看车头附近可不可信（确认“我还在赛道上”） --- */
    for (row = CONTROL_ROW; row <= START_ROW; row++)
        if (row_state(row) == ROW_OK) near_ok++;

    dbg_row_near_ok = near_ok;
    if (near_ok < CROSS_NEAR_OK_MIN) return 0;        /* 自己都快没线了，别乱补 */

    /* --- 1) 从车头往远处扫：圈出第一段“连续异常带”，同时收集证据 --- */
    for (row = START_ROW; row >= END_ROW; row--)
    {
        st = row_state(row);

        if (st == ROW_OK)
        {
            if (near_lost > 0) { far_found = row; break; }    /* 异常带结束 = 远端恢复行 */
            continue;                                        /* 还没进异常带，继续找 */
        }

        if (near_lost < 0) near_lost = row;                  /* 第一次异常 = 近端断点 */

        if      (st == ROW_MISMATCH) mismatch++;
        else if (st == ROW_BOTHLOST) bothlost++;
        else                         lost++;
    }

    dbg_row_mismatch    = mismatch;
    dbg_row_lost        = lost;
    dbg_row_bothlost    = bothlost;
    dbg_cross_near_lost = (near_lost > 0) ? (uint8)near_lost : 0;
    dbg_cross_far_found = (far_found > 0) ? (uint8)far_found : 0;

    if (near_lost < 0) return 0;                                        /* 全线正常 → 正常巡线 */
    if (near_lost - (far_found > 0 ? far_found : END_ROW) < CROSS_GAP_MIN) return 0;

    /* ★证据够不够：弯道只会给 lost，给不出 mismatch / bothlost */
    if (mismatch < CROSS_MISMATCH_MIN && bothlost < CROSS_BOTHLOST_MIN) return 0;

    /* --- 2) 近端“可信行” → 最小二乘拟合进入方向 --- */
    for (row = START_ROW; row >= near_lost + 1; row--)
    {
        if (row_state(row) == ROW_OK)
        {
            mm = ((int)l_line[row] + (int)r_line[row]) / 2;

            ok++;
            sx  += (float)row;
            sy  += (float)mm;
            sxx += (float)row * (float)row;
            sxy += (float)row * (float)mm;
            n++;

            ref_row = row;                                   /* 记下最后一条可信行 */
        }
    }

    if (ok < CROSS_NEAR_OK || n < CROSS_FIT_MIN || ref_row < 0)
    {
        /* 数据不够：退化成“打正”直行 —— 至少不会在十字里画圆弧冲出去 */
        for (row = END_ROW; row <= near_lost; row++) m_line[row] = IMG_CENTER;
        dbg_cross_m0  = IMG_CENTER;
        dbg_cross_m94 = m_line[CONTROL_ROW];
        return 1;
    }

    /* ★最小二乘拟合 mid = a*row + b：这才是真正的“进入方向”（含透视关系） */
    den = (float)n * sxx - sx * sx;
    if (den > 1.0f) { a = ((float)n * sxy - sx * sy) / den;  b = (sy - a * sx) / (float)n; }
    else            { a = 0.0f;  b = (float)m_line[ref_row]; }

    dbg_cross_a100 = (int)(a * 100.0f);
    dbg_cross_m0   = (uint8)(a * (float)ref_row + b);

    /* --- 3) 远端恢复行 far_found 已经在第 1) 步里确定了，这里直接用 --- */

    if (far_found > 0 && far_found < near_lost)
    {
        /* ===== A. 远端看得到 → 两端线性插值 ===== */
        L0 = l_line[ref_row];        R0 = r_line[ref_row];        /* 近端就用“最后一条可信行” */
        L1 = l_line[far_found];      R1 = r_line[far_found];
        span = ref_row - far_found;

        for (row = far_found; row <= near_lost; row++)
        {
            t = row - far_found;
            l = L1 + (L0 - L1) * t / span;
            r = R1 + (R0 - R1) * t / span;
            m = (l + r) / 2;
            if (l < 0) l = 0;  if (l > IMG_W - 1) l = IMG_W - 1;
            if (r < 0) r = 0;  if (r > IMG_W - 1) r = IMG_W - 1;
            if (r - l < 10) { l = m - 5; r = m + 5; }        /* 边线交叉保护 */

            l_line[row] = (uint8)l;  r_line[row] = (uint8)r;  m_line[row] = (uint8)m;
        }
    }
    else
    {
        /* ===== B. 远端看不到（最常见）→ 沿拟合出来的进入方向外推 ===== */
        m_end = (int)(a * (float)near_lost + b);             /* 入口行处的拟合值 = 限幅基准 */

        for (row = END_ROW; row <= near_lost; row++)
        {
            m = (int)(a * (float)row + b);                   /* 直接用拟合直线，斜率不再被量化 */

            if (m > m_end + CROSS_MID_LIMIT) m = m_end + CROSS_MID_LIMIT;   /* ±20 收紧 */
            if (m < m_end - CROSS_MID_LIMIT) m = m_end - CROSS_MID_LIMIT;
            if (m < 0) m = 0;  if (m > IMG_W - 1) m = IMG_W - 1;

            l = m - 20;  r = m + 20;                         /* 示意边线，只为显示 */
            if (l < 0) l = 0;  if (r > IMG_W - 1) r = IMG_W - 1;

            l_line[row] = (uint8)l;  r_line[row] = (uint8)r;  m_line[row] = (uint8)m;
        }
    }

    dbg_cross_m94 = m_line[CONTROL_ROW];

    /* --- 4) 补过的行标记为“已找到” --- */
    for (row = (far_found > 0 ? far_found : END_ROW); row <= near_lost; row++)
    { left_find_flag[row] = 1; right_find_flag[row] = 1; }

    return 1;
}


float compute_servo_angle(uint8 *mid_line, uint8 row, uint8 center_col,
                          float kp, float kd, float mid_angle, float min_angle, float max_angle)
{
    #define DEAD_ZONE   2               /* 死区，防直道抖舵 */
    static int16 last_err = 0;
    int16 err;
    float d_err, offset, target;

    err = (int16)mid_line[row] - (int16)center_col;
    if (err > -DEAD_ZONE && err < DEAD_ZONE) err = 0;

    d_err    = (float)(err - last_err);
    last_err = err;

    offset = kp * err + kd * d_err;
    target = mid_angle - offset;        /* 中线偏右(err>0) → 角度变小 → 右转 */

    if (target > max_angle) target = max_angle;
    if (target < min_angle) target = min_angle;
    return target;
}


/* 巡线总流程：主循环在 image_update() 之后、image_frame_done() 之前调用 */
void tracking_task(void)
{
    scan_lines(image_get_threshold(), left_line, right_line, mid_line, START_ROW, END_ROW);
    cross_flag = cross_fill_new(left_line, right_line, mid_line);

    servo_set_angle( compute_servo_angle(mid_line, CONTROL_ROW, IMG_CENTER,
                                         servo_kp, servo_kd,
                                         SERVO_MID, SERVO_RIGHT_MAX, SERVO_LEFT_MEX) );

    /* ★以后元素判断（环岛/斑马线/出界）就插在这一行前面，改完 mid_line 再算角度 */
}


/* 调试：把左右边线和中线画到快照上，配合 image_show() 用 */
void tracking_draw(void)
{
    uint8 row;
    for (row = END_ROW; row <= START_ROW; row++)
    {
        image_draw_point(row, left_line[row],  0);      /* 左边线 → 黑 */
        image_draw_point(row, right_line[row], 255);    /* 右边线 → 白 */
        image_draw_point(row, mid_line[row],   128);    /* 中线   → 灰 */
    }
    image_draw_point(CONTROL_ROW, mid_line[CONTROL_ROW], 255);   /* 控制行打点 */
}
