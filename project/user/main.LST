   66          // 函数简介     屏幕显示摄像头图像 示例函数（总钻风 MT9V03X 灰度图 + IPS200 液晶屏）
   67          // 参数说明     void
   68          // 返回参数     void
   69          // 使用示例     image_display();                     // 放在主循环 while(1) 内反复调用
   70          // 备注信息     1. 通过 mt9v03x_finish_flag 判断一帧图像是否采集完成 采集完成后才处理 避免画面撕裂
   71          //              2. 采集完成后先把图像拷贝到 display_buffer 再清除标志位
   72          //                 拷贝发生在 DMA 还没有启动的空闲窗口内 不会拷到半帧数据
   73          //                 清除标志位后显示过程不再占用采集 显示和采集互不影响 帧率更高
   74          //              3. 图像默认 1:1 居中显示 188 * 120 需要满屏可以修改 CAMERA_DIS_W / CAMERA_DIS_H
   75          //                 ips200_show_gray_image 内部对每个像素都要做一次除法运算 放大显示会明显变慢
   76          //              4. 不需要防撕裂时 也可以把 mt9v03x_image[0] 直接传给 ips200_show_gray_image 省掉缓冲区
   77          //-------------------------------------------------------------------------------------------------------
             -------------
   78          void image_display (void)
   79          {
   80   1          if(mt9v03x_finish_flag)                                             // 一帧图像采集完成
   81   1          {
   82   2              uint8 threshold = adapt_threshold((uint8 xdata *)mt9v03x_image,188, 120);
   83   2              memcpy(display_buffer, mt9v03x_image, sizeof(display_buffer));  // 立刻拷贝一帧图像 此时 DMA 还没
             -启动 不会拷到半帧数据
   84   2              mt9v03x_finish_flag = 0;                                        // 清除标志位 放行下一帧采集 显示
             -过程不再阻塞摄像头
   85   2      
   86   2              ips200_show_gray_image(0,    // 显示起始 x 坐标
   87   2                                     0,    // 显示起始 y 坐标
   88   2                                     display_buffer[0],                        // 图像首地址
   89   2                                     MT9V03X_W, MT9V03X_H,                     // 图像实际分辨率 宽 高
   90   2                                     CAMERA_DIS_W, CAMERA_DIS_H,               // 屏幕上显示的宽 高
   91   2                                     threshold); // 显示阈值
   92   2      
   93   2                  ips200_show_int16(0,150,speed_l);
   94   2                  ips200_show_int16(0,150 + 16,speed_r);
   95   2          }
   96   1      }
