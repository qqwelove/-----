   74          void DMA_UART1_IRQHandler(void) interrupt DMA_UR1R_VECTOR
   75          {
   76   1          static vuint8 dwon_count = 0;
   77   1      
   78   1          if (DMA_UR1R_STA & 0x01) // 接收完成
   79   1          {
   80   2              DMA_UR1R_STA &= ~0x01;      // 清标志位
   81   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
   82   2      
   83   2              // 程序自动下载
   84   2              if (uart_rx_buff[UART_1][0] == 0x7F)
   85   2              {
   86   3                  if (dwon_count++ > 20)
   87   3                  {
   88   4                      IAP_CONTR = 0x60;
   89   4                  }
   90   3              }
   91   2              else
   92   2              {
   93   3                  dwon_count = 0;
   94   3              }
   95   2      
   96   2              if (uart_rx_handlers[UART_1] != NULL)
   97   2              {
   98   3                  uart_rx_handlers[UART_1](uart_rx_buff[UART_1][0]);
   99   3              }
  100   2          }
  101   1      
  102   1          if (DMA_UR1R_STA & 0x02) // 数据丢弃
  103   1          {
  104   2              DMA_UR1R_STA &= ~0x02;      // 清标志位
  105   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
  106   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  107   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  108   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  109   2          }
  110   1      }
