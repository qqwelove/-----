   39   1                  + p ->kd * -(p ->actual - p ->actual1);
   40   1      
   41   1          if(p->out > 0){p->out += p->OutOffSet;}
   42   1          if(p->out < 0){p->out -= p->OutOffSet;}
   43   1      
