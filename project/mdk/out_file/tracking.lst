   77          /**
   78           * @brief  十字路口检测与补线（上下双向扫描四跳变点法）
   79           * @note   从上到下、从下到上分别扫描左右边线的跳变点（有效→丢线），
   80           *         检测到 3 个或 4 个跳变点即判定为十字路口，
   81           *         用上下有效边界做线性插值填充十字区域的边线，中线置为图像中心直行通过。
   82           * @param  left_line   左边界数组（需预分配 IMG_H 大小）
   83           * @param  right_line  右边界数组（需预分配 IMG_H 大小）
   84           * @param  mid_line    中线数组（需预分配 IMG_H 大小）
   85           * @return uint8       检测到十字路口返回 1，否则返回 0
   86           */
   87          uint8 cross_fill_new(uint8 *left_line, uint8 *right_line, uint8 *mid_line)
   88          {
   89   1          int row;
   90   1          int top_l = -1, top_r = -1;    // 上跳变点行：自上而下扫描，有效→丢线的跳变位置
   91   1          int btm_l = -1, btm_r = -1;    // 下跳变点行：自下而上扫描，有效→丢线的跳变位置
   92   1          int break_cnt;                  // 跳变点计数
   93   1          int top_row, btm_row;          // 统一的上/下跳变点行
   94   1          int range, y_diff;
   95   1          static uint8 crossed_flag = 0; // 连续防抖计数
   96   1      
   97   1          #define JUMP_THRESHOLD      20   // 跳变阈值：相邻行差值超过此值即判定跳变
   98   1          #define LOST_THRESHOLD      30   // 丢线阈值：左<此值 或 右>IMG_W-此值
   99   1      
  100   1          // ---- 1. 自上而下扫描：找上跳变点（正常赛道→十字区域） ----
  101   1          for (row = END_ROW; row < IMG_H - 10; row++)
  102   1          {
  103   2              // 左跳变：正常值跳变为极小值（下行丢线）
  104   2              if (top_l < 0 && (int)left_line[row] - (int)left_line[row + 1] > JUMP_THRESHOLD
  105   2                  && left_line[row + 1] < LOST_THRESHOLD)
  106   2                  top_l = row;
  107   2              // 右跳变：正常值跳变为极大值（下行丢线）
  108   2              if (top_r < 0 && (int)right_line[row + 1] - (int)right_line[row] > JUMP_THRESHOLD
  109   2                  && right_line[row + 1] > IMG_W - 1 - LOST_THRESHOLD)
  110   2                  top_r = row;
  111   2              if (top_l >= 0 && top_r >= 0)
  112   2                  break;
  113   2          }
  114   1      
  115   1          // ---- 2. 自下而上扫描：找下跳变点（正常赛道→十字区域） ----
  116   1          for (row = IMG_H - 1; row > END_ROW + 10; row--)
  117   1          {
  118   2              // 左跳变：正常值跳变为极小值（上行丢线）
  119   2              if (btm_l < 0 && (int)left_line[row - 1] - (int)left_line[row] > JUMP_THRESHOLD
  120   2                  && left_line[row] < LOST_THRESHOLD)
  121   2                  btm_l = row - 1;
C251 COMPILER V5.60.0,  tracking                                                           04/10/26  12:51:53  PAGE 3   

  122   2              // 右跳变：正常值跳变为极大值（上行丢线）
  123   2              if (btm_r < 0 && (int)right_line[row] - (int)right_line[row - 1] > JUMP_THRESHOLD
  124   2                  && right_line[row] > IMG_W - 1 - LOST_THRESHOLD)
  125   2                  btm_r = row - 1;
  126   2              if (btm_l >= 0 && btm_r >= 0)
  127   2                  break;
  128   2          }
  129   1      
  130   1          // ---- 3. 统计跳变点数量 ----
  131   1          break_cnt = 0;
  132   1          if (top_l >= 0) break_cnt++;
  133   1          if (top_r >= 0) break_cnt++;
  134   1          if (btm_l >= 0) break_cnt++;
  135   1          if (btm_r >= 0) break_cnt++;
  136   1      
  137   1          // ---- 4. 跳变点 < 3：不是十字路口，释放补线 ----
  138   1          if (break_cnt < 3)
  139   1          {
  140   2              crossed_flag = 0;
  141   2              return 0;
  142   2          }
  143   1      
  144   1          // ---- 5. 防抖：连续两帧检测到才触发 ----
  145   1          if (crossed_flag == 0)
  146   1          {
  147   2              crossed_flag = 1;
  148   2              return 0;
  149   2          }
  150   1      
  151   1          // ---- 6. 取统一的上/下跳变点行（处理只有 3 个跳变点的情况） ----
  152   1          // 上跳变点行：取两个上跳变点中靠下方的（更深入十字区域）
  153   1          top_row = -1;
  154   1          if (top_l >= 0 && top_r >= 0)
  155   1              top_row = (top_l > top_r) ? top_l : top_r;
  156   1          else if (top_l >= 0)
  157   1              top_row = top_l;
  158   1          else if (top_r >= 0)
  159   1              top_row = top_r;
  160   1      
  161   1          // 下跳变点行：取两个下跳变点中靠上方的
  162   1          btm_row = -1;
  163   1          if (btm_l >= 0 && btm_r >= 0)
  164   1              btm_row = (btm_l < btm_r) ? btm_l : btm_r;
  165   1          else if (btm_l >= 0)
  166   1              btm_row = btm_l;
  167   1          else if (btm_r >= 0)
  168   1              btm_row = btm_r;
  169   1      
  170   1          if (top_row < 0 || btm_row < 0 || top_row >= btm_row) return 0;
  171   1      
  172   1          // ---- 7. 线性插值填充十字区域的边线，利用四个拐点计算中线 ----
  173   1          range = btm_row - top_row;
  174   1          for (row = top_row; row <= btm_row; row++)
  175   1          {
  176   2              y_diff = row - top_row;
  177   2              // 左边线：上跳变点 → 下跳变点 线性插值
  178   2              left_line[row] = (uint8)((int)left_line[top_row]
  179   2                                + ((int)left_line[btm_row] - (int)left_line[top_row]) * y_diff / range);
  180   2              // 右边线：上跳变点 → 下跳变点 线性插值
  181   2              right_line[row] = (uint8)((int)right_line[top_row]
  182   2                                 + ((int)right_line[btm_row] - (int)right_line[top_row]) * y_diff / range);
  183   2              // 中线：基于四个拐点插值后的左右边线取中点
  184   2              mid_line[row] = (uint8)(((int)left_line[row] + (int)right_line[row]) / 2);
  185   2          }
  186   1          return 1;
  187   1      }
