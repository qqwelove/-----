  190          float compute_servo_angle(uint8 *mid_line, uint8 row, uint8 center_col,
  191                                    float kp, float kd, float mid_angle, float min_angle, float max_angle)
  192          {
  193   1          #define DEAD_ZONE   2               /* 死区，防直道抖舵 */
  194   1          static int16 last_err = 0;
  195   1          int16 err;
  196   1          float d_err, offset, target;
  197   1      
  198   1          err = (int16)mid_line[row] - (int16)center_col;
  199   1          if (err > -DEAD_ZONE && err < DEAD_ZONE) err = 0;
  200   1      
  201   1          d_err    = (float)(err - last_err);
  202   1          last_err = err;
  203   1      
  204   1          offset = kp * err + kd * d_err;
  205   1          target = mid_angle - offset;        /* 中线偏右(err>0) → 角度变小 → 右转 */
  206   1      
  207   1          if (target > max_angle) target = max_angle;
  208   1          if (target < min_angle) target = min_angle;
  209   1          return target;
  210   1      }
  211          
  212          
  213          /* 巡线总流程：主循环在 image_update() 之后、image_frame_done() 之前调用 */
  214          void tracking_task(void)
  215          {
  216   1          scan_lines(image_get_threshold(), left_line, right_line, mid_line, START_ROW, END_ROW);
  217   1          cross_flag = cross_fill_new(left_line, right_line, mid_line);
  218   1      
  219   1          servo_set_angle( compute_servo_angle(mid_line, CONTROL_ROW, IMG_CENTER,
  220   1                                               servo_kp, servo_kd,
  221   1                                               SERVO_MID, SERVO_RIGHT_MAX, SERVO_LEFT_MEX) );
  222   1      
  223   1          /* ★以后元素判断（环岛/斑马线/出界）就插在这一行前面，改完 mid_line 再算角度 */
  224   1      }
