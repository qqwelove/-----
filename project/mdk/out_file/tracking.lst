   57   2              else if (right_find_flag[row])
   58   2                  m = (int16)right_line[row] - HALF_WIDTH;      /* 左丢 → 靠右线推 */
   59   2              else if (left_find_flag[row])
   60   2                  m = (int16)left_line[row] + HALF_WIDTH;       /* 右丢 → 靠左线推 */
   61   2              else
   62   2                  m = (row < START_ROW) ? mid_line[row + 1] : IMG_CENTER;   /* 都丢 → 继承更近那行 */
   63   2      
   64   2              if (m < 0)         m = 0;
   65   2              if (m > IMG_W - 1) m = IMG_W - 1;
   66   2              mid_line[row] = (uint8)m;
   67   2      
   68   2              /* 下一行的搜索种子 = 本行中线（限幅防跑飞） */
   69   2              center = (uint8)m;
   70   2              if (center < SEARCH_RANGE)         center = SEARCH_RANGE;
   71   2              if (center > IMG_W - SEARCH_RANGE) center = IMG_W - SEARCH_RANGE;
   72   2          }
   73   1      }
