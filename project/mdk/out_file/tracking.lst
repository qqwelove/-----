   15          /*-------------------------------------------------------------------
   16           * 逐行提取左右边线并合成中线
   17           * 赛道模型：白底 + 两侧黑边线；从上一行中线位置出发，向左右找“白→黑”跳变（黑线内沿）
   18           * ★丢线时保留哨兵值：左丢 left_line=0，右丢 right_line=IMG_W-1
   19           *    —— cross_fill_new 的 LOST_THRESHOLD 判据就是靠这两个值识别丢线的，千万别改！
   20           *------------------------------------------------------------------*/
   21          void scan_lines(uint8 threshold, uint8 *left_line, uint8 *right_line, uint8 *mid_line,
   22                          uint8 start_row, uint8 end_row)
   23          {
   24   1          int16 row, col;
   25   1          int16 left, right, m;
   26   1          uint8 center = IMG_CENTER;
   27   1      
   28   1          for (row = start_row; row >= (int16)end_row; row--)
   29   1          {
   30   2              left  = -1;
   31   2              right = -1;
   32   2      
   33   2              /* 左边界：从 center 向左找 白→黑 跳变（黑线右沿 = 白路面左边界） */
   34   2              for (col = center; col >= 3; col--)
   35   2              {
   36   3                  if (mt9v03x_image[row][col] > threshold && mt9v03x_image[row][col - 1] <= threshold)
   37   3                  { left = col; break; }
   38   3              }
   39   2              /* 右边界：从 center 向右找 白→黑 跳变 */
   40   2              for (col = center; col < IMG_W - 3; col++)
   41   2              {
   42   3                  if (mt9v03x_image[row][col] > threshold && mt9v03x_image[row][col + 1] <= threshold)
   43   3                  { right = col; break; }
   44   3              }
   45   2      
   46   2              /* 存边线：丢线保留哨兵值 + 置标志位 */
   47   2              if (left  < 0) { left_find_flag[row]  = 0; left_line[row]  = 0;           }
   48   2              else           { left_find_flag[row]  = 1; left_line[row]  = (uint8)left; }
   49   2      
   50   2              if (right < 0) { right_find_flag[row] = 0; right_line[row] = IMG_W - 1;   }
   51   2              else           { right_find_flag[row] = 1; right_line[row] = (uint8)right;}
   52   2      
   53   2              /* 合成中线：单边丢线用半赛道宽推算，双边丢线继承更近的一行
   54   2                 ★只写 mid_line，绝对不要回写 left_line / right_line！ */
   55   2              if      (left_find_flag[row] && right_find_flag[row])
   56   2                  m = ((int16)left_line[row] + (int16)right_line[row]) / 2;
