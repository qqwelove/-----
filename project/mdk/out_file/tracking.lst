  227          /* 调试：把左右边线和中线画到快照上，配合 image_show() 用 */
  228          void tracking_draw(void)
  229          {
  230   1          uint8 row;
  231   1          for (row = END_ROW; row <= START_ROW; row++)
  232   1          {
  233   2              image_draw_point(row, left_line[row],  0);      /* 左边线 → 黑 */
  234   2              image_draw_point(row, right_line[row], 255);    /* 右边线 → 白 */
  235   2              image_draw_point(row, mid_line[row],   128);    /* 中线   → 灰 */
  236   2          }
  237   1          image_draw_point(CONTROL_ROW, mid_line[CONTROL_ROW], 255);   /* 控制行打点 */
  238   1      }


