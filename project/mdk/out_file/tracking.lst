  116          /*-------------------------------------------------------------------
  117           * 判据只有一条：采样“车头前面那块区域”的平均灰度，低于 TRACK_OUT_MEAN 就认为冲出赛道。
  118           *
  119           * ★为什么不用大津阈值去算“黑点比例”：
  120           *   大津阈值是从同一批像素算出来的，它总会把直方图劈成两半，
  121           *   于是“按大津阈值统计的黑点比例”会被自适应掉（出界了也常常只有 50% 左右），
  122           *   能不能触发还取决于 image.c 里的限幅值 —— 自指涉的坏判据，已弃用。
C251 COMPILER V5.60.0,  tracking                                                           04/10/26  21:29:38  PAGE 3   

  123           * ★为什么用【平均灰度】而不是【比例】：
  124           *   平均灰度是绝对量，不依赖任何动态阈值，算一次、标一次就固定，简单可靠。
  125           * ★为什么只采样“车头前面”：
  126           *   车还在不在赛道上，看车头前面那块地最准：
  127           *     十字路口中间是白的 → 平均灰度很高 → 不会误判
  128           *     冲出赛道对着暗地面 → 平均灰度很低 → 触发
  129           * ★必须在主循环里调用（要遍历图像）；绝对不要塞进 1ms / 5ms 定时中断。
  130           *
  131           * 【怎么标定 TRACK_OUT_MEAN】把 track_out_mean_min 打到屏上看：
  132           *   ① 正常在赛道上跑一圈，记下 track_out_mean_min（这是"赛道上最暗"的值，比如 120）
  133           *   ② 故意冲出赛道，记下 track_out_mean_min（会掉得很低，比如 35）
  134           *   ③ TRACK_OUT_MEAN 取两者中间（例如 (120+35)/2 ≈ 78），留出余量
  135           *------------------------------------------------------------------*/
  136          #define TRACK_OUT_MEAN      100   /* ★车头前面平均灰度低于这个值 → 判为出界（按上面方法标定） */
  137          #define TRACK_OUT_CONFIRM   3    /* 连续这么多帧成立才算，防单帧误判 */
  138          #define TRACK_OUT_LATCH     1    /* 1 = 判出后永久停机（比赛用）  0 = 条件消失自动恢复（调试用） */
  139          
  140          uint8 track_out_flag     = 0;    /* 1 = 已判出界（锁存） */
  141          uint8 track_out_cnt      = 0;    /* 连续命中帧数 */
  142          uint8 track_out_mean     = 0;    /* ★调试用：本帧“车头前面”的平均灰度 */
  143          uint8 track_out_mean_min = 255;  /* ★调试用：开机以来见过的最小平均灰度（峰值保持，标定就看它） */
  144          
  145          
  146          /*-------------------------------------------------------------------
  147           * 出界检测：返回 1 = 出界
  148           * 采样范围：第 60~119 行（车头那半边），隔 3 列取一点
  149           *------------------------------------------------------------------*/
  150          uint8 track_out_check(void)
  151          {
  152   1          uint16 row, col;
  153   1          uint32 sum = 0;
  154   1          uint16 total = 0;
  155   1      
  156   1          if (TRACK_OUT_LATCH && track_out_flag) return 1;        /* 已锁存 → 直接返回 */
  157   1      
  158   1          for (row = 60; row <= 119; row += 3)
  159   1          {
  160   2              for (col = 5; col < IMG_W - 5; col += 3)
  161   2              {
  162   3                  sum += mt9v03x_image[row][col];
  163   3                  total++;
  164   3              }
  165   2          }
  166   1      
  167   1          if (total == 0) return 0;
  168   1      
  169   1          track_out_mean = (uint8)(sum / total);                  /* 本帧平均值 */
  170   1      
  171   1          if (track_out_mean < track_out_mean_min)                /* 峰值保持：记住最暗的那一帧 */
  172   1              track_out_mean_min = track_out_mean;
  173   1      
  174   1          if (track_out_mean < TRACK_OUT_MEAN)                    /* ★唯一的判据 */
  175   1          {
  176   2              if (track_out_cnt < 250) track_out_cnt++;
  177   2              if (track_out_cnt >= TRACK_OUT_CONFIRM) track_out_flag = 1;
  178   2          }
  179   1          else
  180   1          {
  181   2              track_out_cnt = 0;                                  /* 只要有一帧不像，就重新计数 */
  182   2          }
  183   1      
  184   1          return track_out_flag;
  185   1      }
